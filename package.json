{
  "name": "dsh-codex-oauth-bridge",
  "version": "0.1.1",
  "description": "Zero-config ChatGPT OAuth and Codex model setup for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --check index.js && node --check client.js && node test.js",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "codex",
    "openai",
    "oauth",
    "plugin"
  ],
  "author": "zzx547651745",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzx547651745/dsh-codex-oauth-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/zzx547651745/dsh-codex-oauth-bridge/issues"
  },
  "homepage": "https://github.com/zzx547651745/dsh-codex-oauth-bridge#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-settings"],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
